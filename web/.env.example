# 复制为 .env 后填写。.env 已被 gitignore，不要提交。

# ---- TMDB（必填，二选一）----
# 推荐 v4 Bearer Token（TMDB 后台 → 设置 → API → API 读访问令牌）
TMDB_TOKEN=
# 或用 v3 API Key
TMDB_KEY=

# ---- 访问控制（对外暴露时必须设）----
# 访问口令；留空 = 不鉴权（此时务必保持 BIND_ADDR=127.0.0.1，切勿对外）
SITE_PASSWORD=
# 会话签名密钥；留空则每次启动随机生成，重启后需重新登录
# 生成：openssl rand -hex 32
SITE_SECRET=

# ---- 网络 ----
# 端口发布地址：127.0.0.1 仅本机可访问；0.0.0.0 对外（须先设 SITE_PASSWORD）
BIND_ADDR=127.0.0.1

# 需要代理才能访问 TMDB / 豆瓣时取消注释（宿主机上的代理）
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890

# Prowlarr（可选，作为 bitmagnet 之外的补充索引源）
PROWLARR_API_KEY=
# PROWLARR_URL=http://host.docker.internal:9696
# BITMAGNET_URL=http://host.docker.internal:3333

# ---- 同步与节流 ----
# TMDB 同步周期（小时），默认 24
SYNC_INTERVAL_H=24
# 置 1 则启动后强制全量重拉各榜单（修复数据后记得改回 0）
FULL_SYNC=0
# 封面缓存上限（MB）
IMGCACHE_MAX_MB=2048
# 豆瓣 Top250 榜单快照与榜内缺片补录的刷新周期（天），默认 7
# DOUBAN250_REFRESH_DAYS=7
